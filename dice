import pygame
import random
import time
from OpenGL.GL import *
from OpenGL.GLU import *
from pygame.locals import *

dice_faces = {
    1: [(0, 0)],
    2: [(-0.3, -0.3), (0.3, 0.3)],
    3: [(-0.3, -0.3), (0, 0), (0.3, 0.3)],
    4: [(-0.3, -0.3), (-0.3, 0.3), (0.3, -0.3), (0.3, 0.3)],
    5: [(-0.3, -0.3), (-0.3, 0.3), (0.3, -0.3), (0.3, 0.3), (0, 0)],
    6: [(-0.3, -0.3), (-0.3, 0), (-0.3, 0.3), (0.3, -0.3), (0.3, 0), (0.3, 0.3)],
}

def draw_dice(face, rotation=(0, 0, 0)):
    glPushMatrix()
    glRotatef(rotation[0], 1, 0, 0)
    glRotatef(rotation[1], 0, 1, 0)
    glRotatef(rotation[2], 0, 0, 1)
    
    # Draw cube
    glBegin(GL_QUADS)
    
    # Front face (white)
    glColor3f(1, 1, 1)
    glVertex3f(-0.5, -0.5, 0.5)
    glVertex3f(0.5, -0.5, 0.5)
    glVertex3f(0.5, 0.5, 0.5)
    glVertex3f(-0.5, 0.5, 0.5)
    
    # Back face
    glColor3f(0.9, 0.9, 0.9)
    glVertex3f(-0.5, -0.5, -0.5)
    glVertex3f(0.5, -0.5, -0.5)
    glVertex3f(0.5, 0.5, -0.5)
    glVertex3f(-0.5, 0.5, -0.5)
    
    # Top face
    glColor3f(0.8, 0.8, 0.8)
    glVertex3f(-0.5, 0.5, -0.5)
    glVertex3f(0.5, 0.5, -0.5)
    glVertex3f(0.5, 0.5, 0.5)
    glVertex3f(-0.5, 0.5, 0.5)
    
    # Bottom face
    glColor3f(0.7, 0.7, 0.7)
    glVertex3f(-0.5, -0.5, -0.5)
    glVertex3f(0.5, -0.5, -0.5)
    glVertex3f(0.5, -0.5, 0.5)
    glVertex3f(-0.5, -0.5, 0.5)
    
    # Left face
    glColor3f(0.6, 0.6, 0.6)
    glVertex3f(-0.5, -0.5, -0.5)
    glVertex3f(-0.5, 0.5, -0.5)
    glVertex3f(-0.5, 0.5, 0.5)
    glVertex3f(-0.5, -0.5, 0.5)
    
    # Right face
    glColor3f(0.5, 0.5, 0.5)
    glVertex3f(0.5, -0.5, -0.5)
    glVertex3f(0.5, 0.5, -0.5)
    glVertex3f(0.5, 0.5, 0.5)
    glVertex3f(0.5, -0.5, 0.5)
    
    glEnd()
    
    # Draw dots on all faces (simplified - in reality you'd need to rotate for each face)
    glPointSize(10)
    glColor3f(0, 0, 0)
    glBegin(GL_POINTS)
    for x, y in dice_faces[face]:
        glVertex3f(x, y, 0.51)  # Front face
    glEnd()
    
    glPopMatrix()

def main():
    pygame.init()
    display = (800, 600)
    pygame.display.set_mode(display, DOUBLEBUF | OPENGL)
    gluPerspective(45, (display[0] / display[1]), 0.1, 50.0)
    glTranslatef(0.0, 0.0, -5)
    
    rolling = False
    face = 1
    rotation = [0, 0, 0]
    roll_start_time = 0
    roll_duration = 3  # seconds
    
    clock = pygame.time.Clock()
    
    while True:
        for event in pygame.event.get():
            if event.type == QUIT:
                pygame.quit()
                return
            if event.type == KEYDOWN:
                if event.key == K_SPACE and not rolling:
                    rolling = True
                    roll_start_time = time.time()
                    face = random.randint(1, 6)
                if event.key == K_ESCAPE:
                    pygame.quit()
                    return
        
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
        
        if rolling:
            elapsed = time.time() - roll_start_time
            if elapsed < roll_duration:
                # Fast random rotation during roll
                rotation = [
                    (rotation[0] + random.uniform(10, 30)) % 360,
                    (rotation[1] + random.uniform(10, 30)) % 360,
                    (rotation[2] + random.uniform(10, 30)) % 360
                ]
            else:
                rolling = False
                # Snap to a clean orientation for the final face
                # These are example rotations that would show each face forward
                # In a complete implementation, you'd need proper rotations for all faces
                if face == 1:
                    rotation = [0, 0, 0]
                elif face == 6:
                    rotation = [180, 0, 0]
                elif face == 2:
                    rotation = [0, 90, 0]
                elif face == 5:
                    rotation = [0, -90, 0]
                elif face == 3:
                    rotation = [90, 0, 0]
                elif face == 4:
                    rotation = [-90, 0, 0]
        
        # Add some lighting for better 3D effect
        glEnable(GL_LIGHTING)
        glEnable(GL_LIGHT0)
        glLightfv(GL_LIGHT0, GL_POSITION, [1, 1, 1, 0])
        glMaterialfv(GL_FRONT, GL_AMBIENT_AND_DIFFUSE, [0.8, 0.8, 0.8, 1.0])
        
        draw_dice(face, rotation)
        
        pygame.display.flip()
        clock.tick(60)

if __name__ == "__main__":
    main()
